{
  // Arnav Chat edge API (Cloudflare Workers free plan).
  // Secrets (never committed) — set with `wrangler secret put <NAME>`:
  //   FIREBASE_SERVICE_ACCOUNT  full service-account JSON (FCM + Firestore read)
  //   CLOUDINARY_API_KEY
  //   CLOUDINARY_API_SECRET
  "name": "arnav-chat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "arnavchat-a16",
    "CLOUDINARY_CLOUD_NAME": "qmzjruou"
  },
  // Per-user rate limits (key = Firebase uid).
  "ratelimits": [
    { "name": "NOTIFY_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
