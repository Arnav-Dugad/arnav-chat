{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['online']) && newData.child('online').isBoolean())",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "groupMembers": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && $chatId.length >= 20 && !$chatId.contains('_')",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null && ($chatId === auth.uid || $chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid) || root.child('groupMembers').child($chatId).child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($chatId === auth.uid || $chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid) || root.child('groupMembers').child($chatId).child(auth.uid).exists())",
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now)"
        }
      }
    }
  }
}
